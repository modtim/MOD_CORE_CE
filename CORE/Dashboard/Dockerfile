# --- Stage 1: Build Environment ---
# Use a specific Node.js version on Alpine for a smaller footprint
FROM node:18.17.1-alpine AS builder

# Set the working directory
WORKDIR /app

# Install dependencies first to leverage Docker layer caching
# FX.147.p2b — hash-pinned deps: `COPY package-lock.json` WITHOUT the `*`
# glob so a missing lockfile fails the build loudly, and `npm ci` installs
# exactly what package-lock.json pins (integrity hashes verified; it errors
# if the lockfile is out of sync with package.json instead of silently
# re-resolving like `npm install` did).
COPY package.json package-lock.json ./
RUN npm ci

# Copy configuration and source code
# This is more efficient thanks to the .dockerignore file
COPY . .

# Build the Tailwind CSS file
RUN npm run build:css

# BUG.B50: js/vendor/assistant-nav.js is generated by
# CORE/WorkflowBuilder/lib/assistant-nav/build-dashboard.js (its input, navActions.ts,
# lives in WorkflowBuilder — outside this build context), and is COMMITTED to git
# (.gitignore re-includes it past the blanket vendor/ rule) so every build context
# carries it. Fail the build loudly if it is ever missing — shipping without it 404s
# /js/vendor/assistant-nav.js and silently disables the in-app assistant
# (assistant-launcher.js / assistant-panel.js log "ModAssistantNav unavailable").
RUN sh -c 'test -f js/vendor/assistant-nav.js || { echo "FATAL: js/vendor/assistant-nav.js missing — regenerate: node CORE/WorkflowBuilder/lib/assistant-nav/build-dashboard.js, then commit it"; exit 1; }'

# --- Font Handling ---
# Manrope is self-hosted under ./branding/fonts/ (variable woff2 from
# tokens.css's @font-face). The legacy Google-Fonts download for Inter
# was removed in launch-day-followup-5 §4 (semantic theming refactor)
# — no network call at build time.

# --- Stage 2: Production Environment ---
# Use a lightweight Nginx image as the final base
FROM nginx:1.25.2-alpine

# Set working directory for Nginx content
WORKDIR /usr/share/nginx/html

# Remove the default Nginx configuration and content
RUN rm -rf ./* /etc/nginx/conf.d/*

# Copy the custom Nginx configuration
COPY nginx.conf /etc/nginx/nginx.conf

# CSP-1 phase 1: the shared security-header snippet nginx.conf `include`s in
# every location that sets its own add_header (nginx drops the server-level
# ones there). Must sit next to nginx.conf, not in the web root.
COPY security-headers.conf /etc/nginx/security-headers.conf

# Copy the config injection script
COPY inject-config.sh /inject-config.sh
RUN chmod +x /inject-config.sh

# Copy all built assets from the 'builder' stage
COPY --from=builder /app/index.html .
# --- FIX ---
# The path to accept-invitation.html was incorrect.
# It lives inside the 'pages' directory in the builder stage.
COPY --from=builder /app/pages/accept-invitation.html .
# --- END FIX ---
# external-invite-accept-ui — public accept page for external folder
# invitations, served at /accept-invite (see nginx.conf). Copied to the web
# root like accept-invitation.html so nginx serves it directly instead of
# falling back to the SPA login gate.
COPY --from=builder /app/pages/accept-external-invite.html .
# (favicon.png removed — the favicon now lives in ./branding/favicons/ which
#  is copied wholesale below, so no standalone favicon COPY is needed.)
COPY --from=builder /app/sw-retry.js .
COPY --from=builder /app/style.css .
COPY --from=builder /app/tailwind.css .
COPY --from=builder /app/tokens.css .
COPY --from=builder /app/js ./js
COPY --from=builder /app/pages ./pages
COPY --from=builder /app/modals ./modals
# Public "share as app" embed surface (/embed/run.html). Must be in the image
# or nginx falls back to the SPA index.html and an embed viewer gets the
# "Checking authentication…" login gate instead of the run page.
COPY --from=builder /app/embed ./embed
COPY --from=builder /app/branding ./branding
# Vendored third-party libs (e.g. gsplat for the Gaussian-splat viewer) —
# served at /vendor/* and referenced by the index.html import map. Kept local
# instead of a CDN so the splat viewer doesn't depend on esm.sh being up.
COPY --from=builder /app/vendor ./vendor

# Tray app download page (WIN.1.s16). nginx.conf serves `location = /downloads.html`
# with try_files $uri =404, so the file itself must be in the web root — the
# ./downloads volume below only holds the installers + manifest.json. Without
# this COPY the page 404s (nginx falls through to the SPA login gate / 404).
COPY --from=builder /app/downloads.html .

# FX-nginx-404 (10-08) — the other standalone documents the edge proxy now
# forwards to this container (persistent-stacks, mesh-rpo, workflow-triggers)
# live at the web root, not under ./pages, so they need their own COPY like
# downloads.html; `COPY --from=builder /app/pages ./pages` does not pick them
# up. Without these the proxy gets the SPA index.html fallback instead of the
# standalone page.
COPY --from=builder /app/persistent-stacks.html .
# mesh-rpo.html is not in CE
COPY --from=builder /app/workflow-triggers.html .

# Create downloads directory for tray app installers (mounted as volume)
RUN mkdir -p ./downloads

# Expose port 80 to allow traffic
EXPOSE 80

# The command to start Nginx with config injection
CMD ["/bin/sh", "/inject-config.sh"]