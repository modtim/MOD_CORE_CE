# =============================================================================
# CE sizing profile — LARGE. Target box: 24 GB+ RAM / 8+ vCPU (a workstation,
# a fleet/dev server, the larger fleet-class boxes). This is the profile for installs
# that scale to thousands of workers: the API pool is NOT pinned to a fixed
# count, it is auto-sized from the container's own cgroup limits.
#
# How these get into your .env: scripts/first-run-secrets.sh appends the block
# below (minus its comments) on first run, auto-picked from RAM (cgroup-aware); the CPU count is shown but does not choose the profile.
# Any CE_* line you already have in .env is left alone — your override wins.
# Edit values in .env, not in this file.
#
# Keys are the CE_* knobs open-core/overlay/docker-compose.yml interpolates.
# =============================================================================
# 0 = AUTO-SIZE, not "zero workers". The compose line is
#   API_UVICORN_WORKERS=${CE_API_WORKERS:-1}, and compose's `:-` treats an
#   EMPTY value as unset, so an empty CE_API_WORKERS would collapse to the
#   small-profile 1 — it cannot express "auto". 0 does: CORE/API/utils/worker_
#   sizing.py:337 (decide()) reads API_UVICORN_WORKERS and only short-circuits
#   when the parsed value is > 0 (worker_sizing.py:341 `if n > 0`), so 0 falls
#   through to compute(probe()) — the cpu/memory/database ceiling formula,
#   clamped to [API_UVICORN_WORKERS_MIN=2, API_UVICORN_WORKERS_MAX=32]
#   (worker_sizing.py:317/318). CORE/API/entrypoint.sh:142 then feeds that
#   number to `uvicorn --workers`.
#
# Set a positive number here (e.g. 8) to pin the pool instead of auto-sizing.
CE_API_WORKERS=0
CE_API_MEM=8g
CE_KC_MEM=3g
CE_KC_HEAP=-Xmx2g
CE_PG_MEM=8g
CE_KCDB_MEM=1g
CE_WORKER_MEM=1g
CE_VGW_MEM=1g
CE_OPENBAO_MEM=0.5g
CE_VALKEY_MEM=1g
CE_DASH_MEM=0.3g
CE_WB_MEM=1g
# mailpit (SMTP relay + web inbox) is a static Go binary: idle RSS ~15MB, 0.1g rail.
CE_MAILPIT_MEM=0.1g
CE_INIT_MEM=1g
# Postgres's own default is 128MB; raise it with CE_PG_MEM, but keep it well
# under the rail (the rail caps the whole process, buffers included).
CE_PG_SHARED_BUFFERS=2GB
