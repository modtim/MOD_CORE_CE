# =============================================================================
# CE sizing profile — SMALL. Target box: ~4 GB RAM / 2 vCPU (Docker Desktop
# default VM, a small laptop, a 4 GB mini-box). This is the 2400RES2 default
# set: every rail sits just above the measured idle RSS of each container, so
# the whole stack boots inside a 4 GB VM.
#
# How these get into your .env: scripts/first-run-secrets.sh appends the block
# below (minus its comments) on first run, auto-picked from RAM (cgroup-aware); the CPU count is shown but does not choose the profile.
# Any CE_* line you already have in .env is left alone — your override wins.
# Edit values in .env, not in this file.
#
# Keys are the CE_* knobs open-core/overlay/docker-compose.yml interpolates.
# =============================================================================
CE_API_WORKERS=1
# 2400CR2d: uvicorn was OOM-killed at anon-rss 1.47g inside the old 1.5g rail (api restarted once);
# surviving api peak 1.15g, live 0.94g -> 2g gives headroom on the 4g box.
CE_API_MEM=2g
CE_KC_MEM=1g
CE_KC_HEAP=-Xmx640m
# 2400CR2d: postgres cgroup peak 157MB vs the old 0.6g rail -> trimmed to 0.4g to pay for the api raise
# (dind-wide docker scope peaked 3.31g of the 4g box).
CE_PG_MEM=0.4g
CE_KCDB_MEM=0.3g
# 2400CR2d: worker container cgroup peak 429498368 = exactly the old 0.4g cap (CONSTRAINT_MEMCG,
# ~11 mod-worker children killed at ~250MB anon-rss each) -> 0.6g.
CE_WORKER_MEM=0.6g
# 2400CR2e: versitygw cgroup peak 206MB = at the old 0.2g cap -> 0.3g.
CE_VGW_MEM=0.3g
# 2400CR2e: openbao cgroup peak 134MB = 87% of the old 0.15g rail -> 0.2g.
CE_OPENBAO_MEM=0.2g
CE_VALKEY_MEM=0.1g
CE_DASH_MEM=0.1g
CE_WB_MEM=0.3g
# mailpit (SMTP relay + web inbox) is a static Go binary: idle RSS ~15MB, 0.1g rail.
CE_MAILPIT_MEM=0.1g
CE_INIT_MEM=0.25g
